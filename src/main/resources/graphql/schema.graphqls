type Card {
  id: ID!
  cardName: String!
  cardType: String!
  cardBank: String!
  hasAnnualFee: Boolean!
  annualFee: Int!
  rating: Float!
  bonus: Float!
  bonusSpend: Float!
  cashbackFlat: Float!
  cashbackTravel: Float!
  cashbackDining: Float!
  cashbackGrocery: Float!
  cashbackGas: Float!
  cashbackPharmacy: Float!
  cashbackLyft: Float!
  cashbackOfficeSupply: Float!
  cashbackServices: Float!
  cashbackBrand: Float!
  cashbackOther: Float!
  cashbackChoiceHotels: Boolean!
  cashbackHyattHotels: Boolean!
  cashbackHiltonHotels: Boolean!
  cashbackMarriottHotels: Boolean!
  creditScore: Int!
  imageS3Key: String
  imageSourceUrl: String
  relatedCardsByBank(limit: Int = 5): [Card!]!
}

input CardInput {
  cardName: String!
  cardType: String!
  cardBank: String!
  hasAnnualFee: Boolean!
  annualFee: Int!
  rating: Float!
  bonus: Float!
  bonusSpend: Float!
  cashbackFlat: Float!
  cashbackTravel: Float!
  cashbackDining: Float!
  cashbackGrocery: Float!
  cashbackGas: Float!
  cashbackPharmacy: Float!
  cashbackLyft: Float!
  cashbackOfficeSupply: Float!
  cashbackServices: Float!
  cashbackBrand: Float!
  cashbackOther: Float!
  cashbackChoiceHotels: Boolean!
  cashbackHyattHotels: Boolean!
  cashbackHiltonHotels: Boolean!
  cashbackMarriottHotels: Boolean!
  creditScore: Int!
  imageS3Key: String
  imageSourceUrl: String
}

type CardPage {
  content: [Card!]!
  page: Int!
  size: Int!
  totalElements: Int!
  totalPages: Int!
  hasNext: Boolean!
}

input SpendingProfileInput {
  creditScore: Int!
  monthlyTravel: Float!
  monthlyDining: Float!
  monthlyGrocery: Float!
  monthlyGas: Float!
  monthlyPharmacy: Float!
  monthlyLyft: Float!
  monthlyOfficeSupply: Float!
  monthlyServices: Float!
  monthlyBrand: Float!
  monthlyOther: Float!
}

type CategoryAssignment {
  category: String!
  monthlySpend: Float!
  effectiveRate: Float!
  annualCashback: Float!
}

type CardLineupEntry {
  card: Card!
  assignedCategories: [CategoryAssignment!]!
  annualCashback: Float!
  annualFee: Int!
  netAnnualValue: Float!
}

type CardLineupResult {
  entries: [CardLineupEntry!]!
  totalAnnualCashback: Float!
  totalAnnualFees: Int!
  totalNetAnnualValue: Float!
  totalMonthlySpend: Float!
}

type Query {
  cards(
    page: Int = 0
    size: Int = 20
    bank: String
    type: String
    hasAnnualFee: Boolean
  ): CardPage!
  cardById(id: ID!): Card
  cardsByIds(ids: [ID!]!): [Card]!
  cardByName(name: String!): Card
  topRatedCards(limit: Int = 4): [Card!]!
  optimizeCardLineup(input: SpendingProfileInput!): CardLineupResult!
}

type Mutation {
  addCard(input: CardInput!): Card!
  updateCardByName(name: String!, input: CardInput!): Card
}
